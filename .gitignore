# Local environments, including preserved environments from another OS.
.venv*/
**/.venv*/
/bin/
/include/
/lib/
/lib64
/pyvenv.cfg
**/__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
test-results/
playwright-report/
.env
.env.*
!.env.example

