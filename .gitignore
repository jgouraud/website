demos/clip_search_minimal/data/*
!demos/clip_search_minimal/data/deployment/
demos/clip_search_minimal/models/*
!demos/clip_search_minimal/models/ViT-B-32.pt
*.build.lock
.catalog-*/
.catalog-stage-*/
